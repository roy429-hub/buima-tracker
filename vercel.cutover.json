{
  "redirects": [
    {
      "source": "/",
      "destination": "https://tools.buimaenergy.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://tools.buimaenergy.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
